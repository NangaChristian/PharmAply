rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- 0. Global Safety Net ----
    match /{document=**} { 
      allow read, write: if false; 
    }
    
    // ---- Global Primitives ----
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Admins logic
    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" : false) ||
        request.auth.token.email == "christisnaime@gmail.com"
      );
    }

    function getUserRole(uid) {
       return exists(/databases/$(database)/documents/users/$(uid)) ? get(/databases/$(database)/documents/users/$(uid)).data.role : null;
    }
    
    // ---- Validation Helpers ----
    function isValidUser(data) {
       return data.keys().hasAll(['email', 'role', 'name', 'createdAt']) &&
              (data.keys().hasAll(['status']) ? data.status is string : true) &&
              (data.keys().hasAll(['photoUrl']) ? data.photoUrl is string : true) &&
              data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
              data.role is string && (data.role == 'patient' || data.role == 'pharmacy' || data.role == 'driver' || data.role == 'admin' || data.role == 'cashier') &&
              data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
              data.createdAt is timestamp;
    }

    function isValidPharmacy(data) {
       return data.keys().hasAll(['name', 'address', 'ownerId', 'createdAt', 'phoneNumber', 'registrationNumber', 'status']) &&
              (data.keys().hasAll(['operatingLicenseUrl']) ? data.operatingLicenseUrl is string : true) &&
              (data.keys().hasAll(['taxpayerCardUrl']) ? data.taxpayerCardUrl is string : true) &&
              (data.keys().hasAll(['rating']) ? data.rating is number : true) &&
              data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
              data.address is string && data.address.size() > 0 && data.address.size() <= 200 &&
              data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
              data.phoneNumber is string && data.phoneNumber.size() <= 20 &&
              data.registrationNumber is string && data.registrationNumber.size() <= 50 &&
              data.status is string && data.status.size() <= 30 &&
              data.createdAt is timestamp;
    }

    function isValidProduct(data) {
       return data.keys().hasAll(['name', 'category', 'price', 'pharmacyId', 'needsPrescription', 'stock', 'createdAt']) &&
              (data.keys().hasAll(['imageUrl']) ? data.imageUrl is string : true) &&
              data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
              data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
              data.price is number &&
              data.pharmacyId is string && data.pharmacyId.size() > 0 && data.pharmacyId.size() <= 128 &&
              data.needsPrescription is bool &&
              data.stock is number &&
              data.createdAt is timestamp;
    }

    function isValidOrder(data) {
       return data.keys().hasAll(['patientId', 'pharmacyId', 'status', 'total', 'items', 'createdAt', 'updatedAt']) &&
              (data.keys().hasAll(['driverId']) ? data.driverId is string : true) &&
              (data.keys().hasAll(['deliveryAddress']) ? data.deliveryAddress is map : true) &&
              (data.keys().hasAll(['prescriptionId']) ? data.prescriptionId is string : true) &&
              (data.keys().hasAll(['cancellationReason']) ? data.cancellationReason is string : true) &&
              data.patientId is string && data.patientId.size() > 0 && data.patientId.size() <= 128 &&
              data.pharmacyId is string && data.pharmacyId.size() > 0 && data.pharmacyId.size() <= 128 &&
              data.status is string && data.status.size() > 0 && data.status.size() <= 30 &&
              data.total is number &&
              data.items is list && data.items.size() >= 0 && data.items.size() <= 50 &&
              data.createdAt is timestamp &&
              data.updatedAt is timestamp;
    }

    function isValidPrescription(data) {
       return data.keys().hasAll(['patientId', 'fileUrl', 'status', 'createdAt']) &&
              data.patientId is string && data.patientId.size() > 0 && data.patientId.size() <= 128 &&
              data.fileUrl is string && data.fileUrl.size() > 0 && data.fileUrl.size() <= 1000 &&
              data.status is string && data.status.size() > 0 && data.status.size() <= 20 &&
              data.createdAt is timestamp;
    }

    function isValidMessage(data) {
       return data.keys().hasAll(['orderId', 'senderId', 'receiverId', 'text', 'createdAt']) &&
              data.orderId is string && data.orderId.size() > 0 && data.orderId.size() <= 128 &&
              data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
              data.receiverId is string && data.receiverId.size() > 0 && data.receiverId.size() <= 128 &&
              data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
              data.createdAt is timestamp;
    }

    function isValidFlashSale(data) {
       return data.keys().hasAll(['title', 'description', 'discountPercentage', 'endTime', 'createdAt']) &&
              data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
              data.description is string && data.description.size() > 0 && data.description.size() <= 1000 &&
              data.discountPercentage is number && data.discountPercentage >= 0 && data.discountPercentage <= 100 &&
              data.endTime is timestamp &&
              data.createdAt is timestamp;
    }

    function isValidDriver(data) {
       return data.keys().hasAll(['userId', 'name', 'phoneNumber', 'vehicleType', 'vehiclePlate', 'status', 'createdAt', 'isAvailable']) &&
              (data.keys().hasAll(['idCardUrl']) ? data.idCardUrl is string : true) &&
              (data.keys().hasAll(['drivingLicenseUrl']) ? data.drivingLicenseUrl is string : true) &&
              (data.keys().hasAll(['currentLocation']) ? data.currentLocation is map : true) &&
              (data.keys().hasAll(['currentOrderId']) ? data.currentOrderId is string : true) &&
              data.userId is string && data.userId.size() > 0 &&
              data.name is string && data.name.size() > 0 &&
              data.phoneNumber is string &&
              data.vehicleType is string &&
              data.vehiclePlate is string &&
              data.status is string &&
              data.isAvailable is bool &&
              data.createdAt is timestamp;
    }

    // ---- Paths ----
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isAdmin(); // only admin can list all users
      
      allow create: if isSignedIn() 
                   && isValidId(userId)
                   && request.auth.uid == userId
                   && isValidUser(incoming())
                   && incoming().createdAt == request.time
                   && (incoming().role == 'patient' || incoming().role == 'pharmacy' || incoming().role == 'driver' || incoming().role == 'admin' || isAdmin());

      allow update: if isSignedIn() && isValidId(userId) && (
          isAdmin() ||
          (
             request.auth.uid == userId &&
             isValidUser(incoming()) &&
             incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoUrl']) &&
             incoming().email == existing().email &&
             incoming().role == existing().role &&
             incoming().createdAt == existing().createdAt
          )
      );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /drivers/{driverId} {
      allow get: if isSignedIn() && isValidId(driverId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() && isValidId(driverId) && (request.auth.uid == driverId || isAdmin()) && isValidDriver(incoming()) && incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && isValidId(driverId) && (
          isAdmin() ||
          (
             existing().userId == request.auth.uid &&
             isValidDriver(incoming()) &&
             incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phoneNumber', 'vehicleType', 'vehiclePlate', 'isAvailable', 'currentLocation', 'currentOrderId']) &&
             incoming().userId == existing().userId &&
             incoming().createdAt == existing().createdAt &&
             incoming().status == existing().status
          )
      );
    }

    match /pharmacies/{pharmacyId} {
      allow get: if isSignedIn() && isValidId(pharmacyId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() && isValidId(pharmacyId) && (request.auth.uid == pharmacyId || isAdmin()) && isValidPharmacy(incoming()) && incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && isValidId(pharmacyId) && (
          isAdmin() ||
          (
             existing().ownerId == request.auth.uid &&
             isValidPharmacy(incoming()) &&
             incoming().diff(existing()).affectedKeys().hasOnly(['name', 'address', 'phoneNumber']) &&
             incoming().ownerId == existing().ownerId &&
             incoming().createdAt == existing().createdAt &&
             incoming().status == existing().status &&
             incoming().registrationNumber == existing().registrationNumber
          )
      );
    }

    match /products/{productId} {
      allow get: if isSignedIn() && isValidId(productId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() && isValidId(productId) && (
         isAdmin() ||
         (
            getUserRole(request.auth.uid) == 'pharmacy' &&
            isValidProduct(incoming()) &&
            incoming().createdAt == request.time
         )
      );

      allow update: if isSignedIn() && isValidId(productId) && (
         isAdmin() ||
         (
            getUserRole(request.auth.uid) == 'pharmacy' &&
            isValidProduct(incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'price', 'needsPrescription', 'stock', 'imageUrl']) &&
            incoming().pharmacyId == existing().pharmacyId &&
            incoming().createdAt == existing().createdAt
         )
      );

      allow delete: if isSignedIn() && isValidId(productId) && (
         isAdmin() || getUserRole(request.auth.uid) == 'pharmacy' // Ideally verify pharmacyId owns this
      );
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (
         isAdmin() || existing().patientId == request.auth.uid || existing().driverId == request.auth.uid || getUserRole(request.auth.uid) == 'pharmacy' || getUserRole(request.auth.uid) == 'driver'
      );
      
      allow list: if isSignedIn() && (
         isAdmin() || resource.data.patientId == request.auth.uid || resource.data.driverId == request.auth.uid || getUserRole(request.auth.uid) == 'pharmacy' || (getUserRole(request.auth.uid) == 'driver' && resource.data.status == 'ready')
      );

      allow create: if isSignedIn() && isValidId(orderId) &&
                    isValidOrder(incoming()) &&
                    incoming().patientId == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isValidId(orderId) && (
          isAdmin() ||
          (
             isValidOrder(incoming()) &&
             incoming().updatedAt == request.time &&
             incoming().patientId == existing().patientId &&
             incoming().createdAt == existing().createdAt &&
             (
                (existing().patientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'cancellationReason'])) ||
                (getUserRole(request.auth.uid) == 'pharmacy' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'items', 'updatedAt', 'cancellationReason'])) ||
                (existing().driverId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                (getUserRole(request.auth.uid) == 'driver' && incoming().diff(existing()).affectedKeys().hasOnly(['driverId', 'status', 'updatedAt']) && existing().driverId == null)
             ) // driver accepting
          )
      );
    }

    match /prescriptions/{prescriptionId} {
       allow get: if isSignedIn() && isValidId(prescriptionId) && (
          isAdmin() || existing().patientId == request.auth.uid || getUserRole(request.auth.uid) == 'pharmacy'
       );

       allow list: if isSignedIn() && (
          isAdmin() || resource.data.patientId == request.auth.uid || getUserRole(request.auth.uid) == 'pharmacy'
       );

       allow create: if isSignedIn() && isValidId(prescriptionId) &&
                     isValidPrescription(incoming()) &&
                     incoming().patientId == request.auth.uid &&
                     incoming().createdAt == request.time;
       
       allow update: if isSignedIn() && isValidId(prescriptionId) && (
          isAdmin() ||
          (
             getUserRole(request.auth.uid) == 'pharmacy' &&
             isValidPrescription(incoming()) &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'pharmacyId']) &&
             incoming().patientId == existing().patientId &&
             incoming().fileUrl == existing().fileUrl &&
             incoming().createdAt == existing().createdAt
          )
       );
    }

    match /messages/{messageId} {
       allow read: if isSignedIn() && isValidId(messageId) && (
          isAdmin() || existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid
       );
       
       allow list: if isSignedIn() && (
          isAdmin() || resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid
       );

       allow create: if isSignedIn() && isValidId(messageId) &&
                     isValidMessage(incoming()) &&
                     incoming().senderId == request.auth.uid &&
                     incoming().createdAt == request.time;
    }

    function isValidReminder(data) {
       return data.keys().hasAll(['patientId', 'medicationId', 'name', 'time', 'frequency', 'active', 'createdAt']) &&
              data.patientId is string &&
              data.medicationId is string &&
              data.name is string &&
              data.time is string &&
              data.frequency is string &&
              data.active is bool &&
              data.createdAt is timestamp;
    }

    match /reminders/{reminderId} {
       allow read: if isSignedIn() && resource.data.patientId == request.auth.uid;
       allow list: if isSignedIn() && resource.data.patientId == request.auth.uid;
       allow create: if isSignedIn() && isValidReminder(incoming()) && incoming().patientId == request.auth.uid && incoming().createdAt == request.time;
       allow update: if isSignedIn() && existing().patientId == request.auth.uid && incoming().patientId == request.auth.uid;
       allow delete: if isSignedIn() && existing().patientId == request.auth.uid;
    }

    function isValidNotification(data) {
       return data.keys().hasAll(['userId', 'title', 'description', 'type', 'createdAt']) &&
              data.userId is string &&
              data.title is string &&
              data.description is string &&
              data.type is string &&
              data.createdAt is timestamp;
    }

    match /notifications/{notificationId} {
       allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
       allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
       allow create: if isSignedIn() && isValidNotification(incoming()) && incoming().userId == request.auth.uid && incoming().createdAt == request.time;
       allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
       allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /flash_sales/{saleId} {
       allow read: if isSignedIn() && isValidId(saleId);
       allow list: if isSignedIn();
       
       allow create: if isSignedIn() && isValidId(saleId) &&
                     isAdmin() &&
                     isValidFlashSale(incoming()) &&
                     incoming().createdAt == request.time;
                     
       allow update: if isSignedIn() && isValidId(saleId) && isAdmin();
       allow delete: if isSignedIn() && isValidId(saleId) && isAdmin();
    }

    match /settings/{settingId} {
       allow read: if isSignedIn(); // Allow everyone to read settings (like TOS, Maintenance Mode)
       allow write: if isAdmin(); // Only admins can modify settings
    }

    match /logs/{logId} {
       allow read: if isAdmin();
       allow write: if isAdmin();
    }

    match /categories/{categoryId} {
       allow read: if isSignedIn();
       allow write: if isAdmin();
    }

    match /support_queries/{queryId} {
       allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
       allow create: if isSignedIn() && incoming().userId == request.auth.uid;
       allow update, delete: if isAdmin();
    }
  }
}
