rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default read access for all paths to allow image rendering
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false; // Fallback rule for write
    }
    
    // Specific folders mapping to the user's UID to allow uploads
    match /prescriptions/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /profiles/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /orders/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /kyc/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /products/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
